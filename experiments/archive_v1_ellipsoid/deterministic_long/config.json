{
  "run": {
    "name": "deterministic_long",
    "seed": 0,
    "data_root": "UNCERTAFACE_DATA",
    "out_dir": "experiments/runs",
    "resume": true,
    "init_from": null,
    "device": "auto",
    "tensorboard": true
  },
  "data": {
    "n_points": 1024,
    "knn_k": 8,
    "use_missing_info": true
  },
  "augmentation": {
    "enabled": true,
    "rotation_deg": 5.0,
    "translation_mm": 3.0,
    "scale": 0.02,
    "jitter_mm": 0.3,
    "dropout": [
      0.0,
      0.2
    ],
    "density_keep": [
      0.6,
      1.0
    ],
    "occlusion_prob": 0.3,
    "occlusion_fraction": [
      0.05,
      0.15
    ]
  },
  "optim": {
    "epochs": 150,
    "batch_size": 16,
    "lr": 0.001,
    "weight_decay": 0.01,
    "warmup_epochs": 3,
    "min_lr_frac": 0.02,
    "grad_clip": 1.0,
    "amp": false,
    "num_workers": 0
  },
  "loss": {
    "reconstruction": "mse",
    "lambda_rec": 1.0,
    "lambda_nll": 0.0,
    "lambda_surface": 0.1,
    "lambda_reg": 0.0,
    "nll_beta": 0.0,
    "nll_warmup_epochs": 5,
    "unit_mm": 10.0,
    "surface_weights": {
      "laplacian": 1.0,
      "edge": 1.0,
      "normal": 0.1
    }
  },
  "early_stopping": {
    "monitor": "val_rmse_mm",
    "patience": 40,
    "min_delta": 0.0
  },
  "monitors": {
    "grad_norm_warn": 100.0,
    "collapse_frac": 0.5,
    "inflation_frac": 0.5,
    "overfit_patience": 5,
    "max_nonfinite_steps": 5
  },
  "model": {
    "use_missing_info": true,
    "probabilistic": false,
    "encoder": {
      "name": "pointnetpp",
      "m1": 256,
      "m2": 64,
      "k1": [
        16,
        32
      ],
      "k2": [
        16,
        32
      ]
    },
    "aggregation": {
      "d_model": 128,
      "n_freq": 6
    },
    "decoder": {
      "n_layers": 2,
      "n_heads": 4,
      "vert_embed_dim": 16,
      "self_attention": true
    },
    "head": {
      "std_bounds_mm": [
        0.1,
        25.0
      ],
      "init_std_mm": 3.0
    }
  }
}